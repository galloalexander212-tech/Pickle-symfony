<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}PICKLE | Book. Compete. Repeat.{% endblock %}</title>

    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alef:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('style.css') }}">
</head>
<body>

    {# ---- FLASH MESSAGES (old getFlash()) ---- #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash {{ label }}" id="flashMsg">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {# ---- NAVBAR (old includes/navbar.php) ---- #}
    {% set currentRoute = app.request.attributes.get('_route') %}

    <header class="navbar">
        <div class="nav-container">

            <a href="/" class="logo">
                <img src="{{ asset('images/logo.png') }}" alt="PICKLE" class="logo-img">
            </a>

            <nav class="nav-links">
                <a href="/" class="{{ currentRoute == 'app_home' ? 'active' : '' }}">HOME</a>
                <a href="{{ path('app_courts') }}" class="{{ currentRoute == 'app_courts' ? 'active' : '' }}">COURTS</a>
                <a href="{{ path('app_openplays') }}" class="{{ currentRoute == 'app_openplays' ? 'active' : '' }}">OPEN PLAYS</a>
                <a href="{{ path('app_tournaments') }}" class="{{ currentRoute == 'app_tournaments' ? 'active' : '' }}">TOURNAMENTS</a>
                <a href="{{ path('app_about') }}" class="{{ currentRoute == 'app_about' ? 'active' : '' }}">ABOUT US</a>
                <a href="{{ path('app_support') }}" class="{{ currentRoute == 'app_support' ? 'active' : '' }}">CONTACT US</a>
            </nav>

            {% if app.user %}
                <a href="{{ path('app_account') }}" class="login-btn">HI, {{ app.user.username|upper }}</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="login-btn">LOG IN</a>
                <a href="{{ path('app_register') }}" class="login-btn">SIGN UP</a>
            {% endif %}

            <button class="menu-btn" id="menuBtn">&#9776;</button>

        </div>
    </header>

    <div class="mobile-menu" id="mobileMenu">
        <a href="/">HOME</a>
        <a href="{{ path('app_courts') }}">COURTS</a>
        <a href="{{ path('app_openplays') }}">OPEN PLAYS</a>
        <a href="{{ path('app_tournaments') }}">TOURNAMENTS</a>
        <a href="{{ path('app_about') }}">ABOUT US</a>
        <a href="{{ path('app_support') }}">CONTACT US</a>
    </div>

    {% block body %}{% endblock %}

    {# ---- FOOTER (old includes/footer.php) ---- #}
    <footer>
        <div class="footer-container">

            <div class="footer-brand">
                <img src="{{ asset('images/logo.png') }}" alt="PICKLE" class="footer-logo-img">
                <p class="footer-tagline">Your ultimate pickleball companion. Book, compete, and repeat.</p>
                <div class="footer-socials">
                    <a href="https://www.facebook.com/p/Alexander-Gallo-61584661173083/" target="_blank" rel="noopener" aria-label="Facebook">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/aalxnndr" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                        </svg>
                    </a>
                    <a href="https://www.tiktok.com/@alxsixander?_r=1&_t=ZS-99jMCkmjFrg" target="_blank" rel="noopener" aria-label="TikTok">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="footer-col">
                <h4>QUICK LINKS</h4>
                <a href="{{ path('app_home') }}">Home</a>
                <a href="{{ path('app_courts') }}">Courts</a>
                <a href="{{ path('app_openplays') }}">Open Plays</a>
                <a href="{{ path('app_tournaments') }}">Tournaments</a>
                <a href="{{ path('app_about') }}">About Us</a>
                <a href="{{ path('app_support') }}">Contact Us</a>
            </div>

            <div class="footer-col">
                <h4>SUPPORT</h4>
                <a href="{{ path('app_support') }}#faqs">FAQs</a>
                <a href="{{ path('app_home') }}#about">How It Works</a>
                <a href="{{ path('app_support') }}#terms">Terms &amp; Conditions</a>
                <a href="{{ path('app_support') }}#privacy">Privacy Policy</a>
            </div>

            <div class="footer-col footer-contact">
                <h4>CONTACT US</h4>

                <div class="footer-contact-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>Dumaguete City, Philippines</span>
                </div>

                <div class="footer-contact-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                    <a href="mailto:galloalexander212@gmail.com">galloalexander212@gmail.com</a>
                </div>

                <div class="footer-contact-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    <a href="tel:+639123456789">+63 912 345 6789</a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <div class="footer-bottom-inner">
                <p>&copy; 2026 PICKLE. All rights reserved.</p>
                <p class="footer-motto">
                    Book. Compete. Repeat.
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="7.5" r="1.6" fill="#171916"></circle>
                        <circle cx="16.5" cy="10.5" r="1.6" fill="#171916"></circle>
                        <circle cx="16.5" cy="15" r="1.6" fill="#171916"></circle>
                        <circle cx="12" cy="17.5" r="1.6" fill="#171916"></circle>
                        <circle cx="7.5" cy="15" r="1.6" fill="#171916"></circle>
                        <circle cx="7.5" cy="10.5" r="1.6" fill="#171916"></circle>
                        <circle cx="12" cy="12.5" r="1.6" fill="#171916"></circle>
                    </svg>
                </p>
            </div>
        </div>
    </footer>

    <script>
        const IS_LOGGED_IN = {{ app.user ? 'true' : 'false' }};
    </script>
    <script src="{{ asset('javascript.js') }}"></script>

</body>
</html>