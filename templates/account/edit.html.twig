<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PICKLE | Edit Profile</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Alef:wght@400;700&amp;family=Alike+Angular&amp;display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('auth.css') }}">

</head>

<body>

<div class="auth-wrap">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash {{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}


    <div class="auth-card">

        <a href="{{ path('app_home') }}" class="auth-logo">
            <img src="{{ asset('images/logo.png') }}" alt="PICKLE" class="auth-logo-img">
        </a>


        <h2 class="auth-title">
            Edit Profile
        </h2>

        <p class="auth-sub">
            Update your account details or change your password.
        </p>


        <form method="POST" action="{{ path('app_account_edit') }}" class="layout-form">

            <input type="hidden" name="action" value="profile">

            <section class="form-section">
                <h3 class="form-section-title">ACCOUNT DETAILS</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label>USERNAME</label>
                        <input type="text" name="username" value="{{ username }}">
                        {% if errors.username is defined %}<p class="field-error">{{ errors.username }}</p>{% endif %}
                    </div>
                    <div class="form-group">
                        <label>EMAIL</label>
                        <input type="email" name="email" value="{{ email }}">
                        {% if errors.email is defined %}<p class="field-error">{{ errors.email }}</p>{% endif %}
                    </div>
                </div>
            </section>
            <div class="form-actions">
                <button type="submit" class="auth-btn form-primary">SAVE CHANGES</button>
            </div>

        </form>


        <div class="auth-divider"></div>

        <form method="POST" action="{{ path('app_account_edit') }}" class="layout-form">

            <input type="hidden" name="action" value="password">

            <section class="form-section">
                <h3 class="form-section-title">CHANGE PASSWORD</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label>CURRENT PASSWORD</label>
                        <input type="password" name="current_password" placeholder="Your current password">
                        {% if errors.current_password is defined %}<p class="field-error">{{ errors.current_password }}</p>{% endif %}
                    </div>
                    <div class="form-group">
                        <label>NEW PASSWORD</label>
                        <input type="password" name="new_password" placeholder="At least 8 characters">
                        {% if errors.new_password is defined %}<p class="field-error">{{ errors.new_password }}</p>{% endif %}
                    </div>
                    <div class="form-group field-full">
                        <label>CONFIRM NEW PASSWORD</label>
                        <input type="password" name="confirm_password" placeholder="Repeat your new password">
                        {% if errors.confirm_password is defined %}<p class="field-error">{{ errors.confirm_password }}</p>{% endif %}
                    </div>
                </div>
                <label class="show-pass">
                    <input type="checkbox"> Show password
                </label>
            </section>
            <div class="form-actions">
                <button type="submit" class="auth-btn form-primary">CHANGE PASSWORD</button>
            </div>

        </form>


        <div class="auth-actions">

            <a href="{{ path('app_account') }}" class="small-btn form-cancel">
                ← MY ACCOUNT
            </a>

        </div>


        <a class="auth-back" href="{{ path('app_home') }}">
            ← BACK TO HOMEPAGE
        </a>

    </div>

</div>


<script>

    document.querySelectorAll(".show-pass input").forEach(function (box) {

        box.addEventListener("change", function () {

            const form = box.closest("form");

            form.querySelectorAll('input[type="password"]').forEach(function (input) {
                input.type = box.checked ? "text" : "password";
            });

        });

    });

</script>

</body>
</html>