{# ==== EVENT CARD — 1:1 port of includes/event-card.php ====
   Expects: ev (App\Entity\Event), joinedIds (array of event ids the user joined) #}
{% set isFull = ev.joinedCount >= ev.maxPlayers %}
{% set hasJoined = ev.id in joinedIds %}

<article class="event-card{{ ev.image is not empty ? ' event-card-photo' : '' }}">

    <div class="event-top">
        <span class="event-badge {{ ev.type }}">{{ ev.type|replace({'_': ' '})|upper }}</span>

        {% if hasJoined %}
            <span class="event-badge joined">JOINED ✓</span>
        {% endif %}
    </div>

    {% if ev.image is not empty %}
        <div class="event-image">
            <img src="{{ asset(ev.image) }}" alt="{{ ev.title }}">
        </div>
    {% endif %}

    <div class="event-text-plate">
        <h3>{{ ev.title }}</h3>

        <p class="event-meta">
            📅 {{ ev.eventDate|date('D, M j, Y') }}
            &nbsp;•&nbsp;
            🕐 {{ ev.eventTime|date('g:i A') }}
        </p>

        <p class="event-meta">◉ {{ ev.location }}</p>

        {% if ev.description is not empty %}
            <p class="event-desc">{{ ev.description }}</p>
        {% endif %}

        {% if ev.prize is not empty %}
            <p class="event-prize">🏆 {{ ev.prize }}</p>
        {% endif %}
    </div>

    <div class="event-bottom">
        <span class="event-slots">{{ ev.joinedCount }} / {{ ev.maxPlayers }} PLAYERS</span>

        {% if hasJoined %}
            <span class="join-state joined">YOU'RE IN ✓</span>
        {% elseif isFull %}
            <span class="join-state full">FULL</span>
        {% elseif not app.user %}
            <a href="{{ path('app_login', {notice: 'login-event'}) }}" class="join-btn">JOIN</a>
        {% else %}
            <form method="POST" action="{{ path('app_event_join', {id: ev.id}) }}" class="join-form">
                <button type="submit" class="join-btn">JOIN</button>
            </form>
        {% endif %}
    </div>

</article>