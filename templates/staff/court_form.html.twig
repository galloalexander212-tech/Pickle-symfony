{% extends 'staff/_layout.html.twig' %}

{% block title %}PICKLE | {{ isEdit ? 'Edit Court' : 'Add Court' }}{% endblock %}
{% block staff_heading %}{{ isEdit ? 'Edit court' : 'Add a court' }}{% endblock %}

{% block staff_content %}
    <h3 class="admin-section-title">{{ isEdit ? 'EDIT COURT — ' ~ court.name : 'ADD A COURT' }}</h3>
    <form method="post" action="{{ isEdit ? path('app_staff_court_edit', {id: court.id}) : path('app_staff_court_new') }}"
          enctype="multipart/form-data" class="layout-form">
        <input type="hidden" name="action" value="{{ isEdit ? 'update' : 'create' }}">
        <input type="hidden" name="_token" value="{{ csrf_token(isEdit ? 'staff_update_court_' ~ court.id : 'staff_create_court') }}">

        <section class="form-section">
            <h4 class="form-section-title">COURT DETAILS</h4>
            <div class="form-grid">
                <div class="form-group">
                    <label for="court-name">COURT NAME</label>
                    <input id="court-name" type="text" name="name" maxlength="100" required
                           value="{{ values.name|default(isEdit ? court.name : '') }}">
                    {% if errors.name is defined %}<p class="field-error">{{ errors.name }}</p>{% endif %}
                </div>
                <div class="form-group field-full">
                    <label for="court-location">LOCATION</label>
                    <input id="court-location" type="text" name="location" maxlength="150" required
                           value="{{ values.location|default(isEdit ? court.location : '') }}">
                    {% if errors.location is defined %}<p class="field-error">{{ errors.location }}</p>{% endif %}
                </div>
                <div class="form-group">
                    <label for="court-rating">RATING (0–5)</label>
                    <input id="court-rating" type="number" name="rating" step="0.1" min="0" max="5" required
                           value="{{ values.rating|default(isEdit ? court.rating : '4.5') }}">
                    {% if errors.rating is defined %}<p class="field-error">{{ errors.rating }}</p>{% endif %}
                </div>
                <div class="form-group">
                    <label for="court-price">PRICE (₱ / HOUR, OPTIONAL)</label>
                    <input id="court-price" type="number" name="price" min="0" max="99999999.99" step="0.01"
                           value="{{ values.price|default(isEdit ? court.price : '') }}">
                    {% if errors.price is defined %}<p class="field-error">{{ errors.price }}</p>{% endif %}
                </div>
            </div>
        </section>

        <section class="form-section">
            <h4 class="form-section-title">MEDIA</h4>
            <div class="form-group upload-card">
                <label for="court-image">COURT PHOTO (JPG, PNG OR WEBP; MAX 2 MB) {{ isEdit and court.image ? '(LEAVE EMPTY TO KEEP CURRENT)' : '(OPTIONAL)' }}</label>
                <input id="court-image" type="file" name="image" accept="image/jpeg,image/png,image/webp">
                {% if errors.image is defined %}<p class="field-error">{{ errors.image }}</p>{% endif %}
                {% if isEdit and court.image %}
                    <p class="edit-note"><img src="{{ asset(court.image) }}" alt="Current photo of {{ court.name }}" class="admin-thumb"></p>
                {% endif %}
            </div>
            <div class="form-group upload-card">
                <label for="court-qr">PAYMENT QR (PNG, JPG OR WEBP; MAX 2 MB) {{ isEdit and court.qrPath ? '(LEAVE EMPTY TO KEEP CURRENT)' : '(OPTIONAL)' }}</label>
                <input id="court-qr" type="file" name="qr" accept="image/png,image/jpeg,image/webp">
                {% if errors.qr is defined %}<p class="field-error">{{ errors.qr }}</p>{% endif %}
                {% if isEdit and court.qrPath %}
                    <p class="edit-note"><img src="{{ asset('uploads/qr/' ~ court.qrPath) }}" alt="Current payment QR" class="admin-thumb"></p>
                {% endif %}
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="auth-btn form-primary">{{ isEdit ? 'SAVE CHANGES' : 'ADD COURT' }}</button>
            <a href="{{ path('app_staff_courts') }}" class="small-btn form-cancel">CANCEL</a>
        </div>
    </form>
{% endblock %}
