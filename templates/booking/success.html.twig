<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% if booking %}PICKLE | Booking Confirmed{% else %}PICKLE | Account Created{% endif %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Alef:wght@400;700&amp;family=Alike+Angular&amp;display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('auth.css') }}">

</head>

<body>

<div class="auth-wrap">

    <div class="auth-card center">

        <div class="success-icon">🏓</div>

        {% if booking %}

            <h2 class="auth-title">
                Booking received!
            </h2>

            <p class="auth-sub">
                {{ booking.courtName }}<br>
                {{ booking.bookingDate|date('D, M j, Y') }} at {{ booking.bookingTime|date('g:i A') }}<br>
                {{ booking.players }} players. Waiting for confirmation.
            </p>

            <div class="auth-actions">

                <a href="{{ path('app_account') }}" class="auth-btn">
                    MY ACCOUNT
                </a>

            </div>

        {% else %}

            <h2 class="auth-title">
                You're in, {{ name }}!
            </h2>

            <p class="auth-sub">
                Your PICKLE account has been created.<br>
                Log in to book courts, join open plays and compete.
            </p>

            <div class="auth-actions">

                <a href="{{ path('app_login') }}" class="auth-btn">
                    LOG IN NOW
                </a>

            </div>

        {% endif %}


        <a class="auth-back" href="{{ path('app_home') }}">
            ← BACK TO HOMEPAGE
        </a>

    </div>

</div>

</body>
</html>